{
  "name": "@prostor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:e2e": "dotenv -e ../../.env -v NEXT_PUBLIC_CANVAS_DEBUG=1 -v NEXT_DIST_DIR=.next-e2e -- next build",
    "start:e2e": "dotenv -e ../../.env -v RATE_LIMIT_MULTIPLIER=50 -v NOTIFICATION_EMAIL_DELAY_MS=3000 -v NEXT_DIST_DIR=.next-e2e -- next start --port 3000"
  },
